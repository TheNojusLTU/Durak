@page "/profile"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using JobTracker.Data
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Your profile | JobTracker</PageTitle>

<div class="account-page">
    <div class="account-card profile-card">
        <p class="eyebrow">Your account</p>
        <h1>Edit your profile</h1>

        @if (CurrentUser is null)
        {
            <p>Loading profile...</p>
        }
        else
        {
            @if (Saved)
            {
                <div class="account-success" role="status">Profile saved.</div>
            }
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="account-error" role="alert">@Error</div>
            }

            <div class="profile-heading">
                <img src="@SelectedAvatar.ImagePath" alt="@SelectedAvatar.Label avatar" />
                <div>
                    <strong>@CurrentUser.UserName</strong>
                    <span>Account ID: @CurrentUser.Id</span>
                </div>
            </div>

            <form method="post" action="/account/profile" class="account-form">
                <AntiforgeryToken />
                <label>
                    Display name
                    <input name="DisplayName" value="@CurrentUser.DisplayName" required minlength="3" maxlength="20" autocomplete="nickname" />
                </label>

                <fieldset>
                    <legend>Profile picture</legend>
                    <div class="avatar-grid">
                        @foreach (var avatar in AvatarCatalog.All)
                        {
                            <label class="avatar-option">
                                <input type="radio" name="AvatarKey" value="@avatar.Key" checked="@(avatar.Key == CurrentUser.AvatarKey)" />
                                <img src="@avatar.ImagePath" alt="@avatar.Label avatar" />
                                <span>@avatar.Label</span>
                            </label>
                        }
                    </div>
                </fieldset>

                <button type="submit" class="account-button">Save changes</button>
            </form>
        }
    </div>
</div>

@code {
    private ApplicationUser? CurrentUser { get; set; }

    private AvatarOption SelectedAvatar =>
        AvatarCatalog.All.FirstOrDefault(avatar => avatar.Key == CurrentUser?.AvatarKey)
        ?? AvatarCatalog.Default;

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    [SupplyParameterFromQuery]
    private bool Saved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser = await UserManager.GetUserAsync(authenticationState.User);
    }
}
