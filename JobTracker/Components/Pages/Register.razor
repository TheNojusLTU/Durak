@page "/register"
@using JobTracker.Data

<PageTitle>Create your JobTracker profile</PageTitle>

<div class="account-page">
    <div class="account-card">
        <p class="eyebrow">Create an account</p>
        <h1>Create your profile</h1>
        <p class="account-intro">Choose a name and avatar. You can change both later.</p>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="account-error" role="alert">@Error</div>
        }

        <form method="post" action="/account/register" class="account-form">
            <AntiforgeryToken />
            <label>
                Username
                <input name="Username" required minlength="3" maxlength="20" autocomplete="username" />
            </label>
            <label>
                Display name
                <input name="DisplayName" required minlength="3" maxlength="20" autocomplete="nickname" />
            </label>
            <label>
                Email <span class="optional">optional</span>
                <input name="Email" type="email" autocomplete="email" />
            </label>
            <label>
                Password
                <input name="Password" type="password" required autocomplete="new-password" />
            </label>

            <fieldset>
                <legend>Choose an avatar</legend>
                <div class="avatar-grid">
                    @foreach (var avatar in AvatarCatalog.All)
                    {
                        <label class="avatar-option">
                            <input type="radio" name="AvatarKey" value="@avatar.Key" checked="@(avatar == AvatarCatalog.Default)" />
                            <img src="@avatar.ImagePath" alt="@avatar.Label avatar" />
                            <span>@avatar.Label</span>
                        </label>
                    }
                </div>
            </fieldset>

            <button type="submit" class="account-button">Create profile</button>
        </form>

        <p class="account-footer">Already registered? <a href="/login">Sign in</a></p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Error { get; set; }
}
