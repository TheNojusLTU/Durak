@page "/login"

<PageTitle>Sign in | JobTracker</PageTitle>

<div class="account-page">
    <div class="account-card">
        <p class="eyebrow">Welcome back</p>
        <h1>Sign in</h1>
        <p class="account-intro">Sign in to continue to your profile.</p>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="account-error" role="alert">@Error</div>
        }

        <form method="post" action="/account/login" class="account-form">
            <AntiforgeryToken />
            <label>
                Username
                <input name="Username" required autocomplete="username" />
            </label>
            <label>
                Password
                <input name="Password" type="password" required autocomplete="current-password" />
            </label>
            <button type="submit" class="account-button">Sign in</button>
        </form>

        <p class="account-footer">New to JobTracker? <a href="/register">Create a profile</a></p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Error { get; set; }
}
