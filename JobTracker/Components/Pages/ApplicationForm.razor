@page "/create-application"
@page "/applications/{Id:int}/edit"
@attribute [Authorize]
@using System.Globalization
@using JobTracker.Data
@using JobTracker.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

<PageTitle>@(IsEditing ? "Edit application" : "Add application") | JobTracker</PageTitle>

<main class="application-form-page">
    <a class="application-form-back" href="/applications">← Back to applications</a>

    @if (NotFound)
    {
        <section class="application-form-card">
            <h1>Application not found</h1>
            <p>It may have been removed or may not belong to your account.</p>
            <a class="application-form-button secondary" href="/applications">Return to applications</a>
        </section>
    }
    else
    {
        <section class="application-form-card">
            <p class="application-form-eyebrow">Job search</p>
            <h1>@(IsEditing ? "Edit application" : "Add an application")</h1>
            <p class="application-form-intro">Save the details so you can keep your job search organized.</p>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="application-form-error" role="alert">@Error</p>
            }

            <form method="post" action="/account/applications/save" class="application-form">
                <AntiforgeryToken />
                <input type="hidden" name="Id" value="@Id" />

                <label>
                    Company name
                    <input name="CompanyName" value="@CompanyName" required maxlength="200" autocomplete="organization" />
                </label>

                <label>
                    Job title
                    <input name="JobTitle" value="@JobTitle" required maxlength="200" />
                </label>

                <label>
                    Location <span class="application-form-optional">optional</span>
                    <input name="Location" value="@Location" maxlength="200" />
                </label>

                <label>
                    Salary <span class="application-form-optional">optional</span>
                    <input name="Salary" type="number" min="0" step="0.01" value="@Salary" />
                </label>

                <label>
                    Job posting URL <span class="application-form-optional">optional</span>
                    <input name="JobUrl" type="url" maxlength="2048" value="@JobUrl" placeholder="https://" />
                </label>

                <div class="application-form-row">
                    <label>
                        Application date
                        <input name="ApplicationDate" type="date" required value="@ApplicationDate" />
                    </label>

                    <label>
                        Status
                        <select name="Status">
                            @foreach (var status in Enum.GetValues<ApplicationStatus>())
                            {
                                <option value="@status" selected="@(status == Status)">@GetStatusLabel(status)</option>
                            }
                        </select>
                    </label>
                </div>

                <label>
                    Notes <span class="application-form-optional">optional</span>
                    <textarea name="Notes" rows="5" maxlength="5000">@Notes</textarea>
                </label>

                <div class="application-form-actions">
                    <button type="submit" class="application-form-button">@(IsEditing ? "Save changes" : "Save application")</button>
                    <a class="application-form-cancel" href="/applications">Cancel</a>
                </div>
            </form>
        </section>
    }
</main>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    private string CompanyName { get; set; } = string.Empty;
    private string JobTitle { get; set; } = string.Empty;
    private string Location { get; set; } = string.Empty;
    private string Salary { get; set; } = string.Empty;
    private string JobUrl { get; set; } = string.Empty;
    private string ApplicationDate { get; set; } = DateTime.UtcNow.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string Notes { get; set; } = string.Empty;
    private ApplicationStatus Status { get; set; } = ApplicationStatus.Applied;
    private bool NotFound { get; set; }
    private bool IsEditing => Id > 0;

    protected override async Task OnInitializedAsync()
    {
        if (!IsEditing)
        {
            return;
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authenticationState.User);
        if (user is null)
        {
            NotFound = true;
            return;
        }

        var application = await DbContext.JobApplications
            .AsNoTracking()
            .SingleOrDefaultAsync(item => item.Id == Id && item.UserId == user.Id);

        if (application is null)
        {
            NotFound = true;
            return;
        }

        CompanyName = application.CompanyName;
        JobTitle = application.JobTitle;
        Location = application.Location ?? string.Empty;
        Salary = application.Salary?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
        JobUrl = application.JobUrl ?? string.Empty;
        ApplicationDate = application.ApplicationDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        Notes = application.Notes ?? string.Empty;
        Status = application.Status;
    }

    private static string GetStatusLabel(ApplicationStatus status) => status switch
    {
        ApplicationStatus.Saved => "Saved",
        ApplicationStatus.Applied => "Applied",
        ApplicationStatus.Interview => "Interview",
        ApplicationStatus.Offer => "Offer",
        ApplicationStatus.Rejected => "Rejected",
        ApplicationStatus.Withdrawn => "Withdrawn",
        _ => status.ToString()
    };
}
