@page "/applications"
@attribute [Authorize]
@using JobTracker.Data
@using JobTracker.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

<PageTitle>Your applications | JobTracker</PageTitle>

<main class="applications-page">
    <header class="applications-header">
        <div>
            <p class="applications-eyebrow">Job search</p>
            <h1>Your applications</h1>
            <p class="applications-intro">Keep track of the opportunities you have applied for.</p>
        </div>
        <a class="applications-add" href="/create-application">Add application</a>
    </header>

    @if (Saved)
    {
        <p class="applications-success" role="status">Application saved.</p>
    }
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="applications-error" role="alert">@Error</p>
    }

    @if (UserId is null)
    {
        <p class="applications-error" role="alert">
            We couldn't load your account. Please sign in again and try once more.
        </p>
    }
    else if (JobApplications.Count == 0)
    {
        <section class="applications-empty">
            <h2>No applications yet</h2>
            <p>Applications you save will appear here.</p>
        </section>
    }
    else
    {
        <section class="applications-list" aria-label="Job applications">
            <p class="applications-count">
                @JobApplications.Count @(JobApplications.Count == 1 ? "application" : "applications")
            </p>
            <div class="applications-table-wrap">
                <table class="applications-table">
                    <thead>
                        <tr>
                            <th scope="col">Company</th>
                            <th scope="col">Job title</th>
                            <th scope="col">Location</th>
                            <th scope="col">Applied</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var application in JobApplications)
                        {
                            <tr>
                                <td data-label="Company">@application.CompanyName</td>
                                <td data-label="Job title" class="application-job-title">@application.JobTitle</td>
                                <td data-label="Location">@(string.IsNullOrWhiteSpace(application.Location) ? "—" : application.Location)</td>
                                <td data-label="Applied">@application.ApplicationDate.ToString("MMM d, yyyy")</td>
                                <td data-label="Status">
                                    <span class="application-status status-@application.Status.ToString().ToLowerInvariant()">
                                        @GetStatusLabel(application.Status)
                                    </span>
                                </td>
                                <td data-label="Actions">
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-primary btn-sm" href="@($"/applications/{application.Id}/edit")">
            Edit
        </a>
        
        <form action="/account/applications/delete" method="post" class="m-0">
            <AntiforgeryToken />
            <input type="hidden" name="Id" value="@application.Id" />
            <button type="submit" class="btn btn-outline-danger btn-sm">
                Delete
            </button>
        </form>
    </div>
</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>

@code {
    private string? UserId { get; set; }

    private List<JobApplication> JobApplications { get; set; } = [];

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    [SupplyParameterFromQuery]
    private bool Saved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authenticationState.User);
        UserId = user?.Id;

        if (UserId is null)
        {
            return;
        }

        JobApplications = await DbContext.JobApplications
            .AsNoTracking()
            .Where(application => application.UserId == UserId)
            .OrderByDescending(application => application.ApplicationDate)
            .ThenBy(application => application.CompanyName)
            .ToListAsync();
    }

    private static string GetStatusLabel(ApplicationStatus status) => status switch
    {
        ApplicationStatus.Saved => "Saved",
        ApplicationStatus.Applied => "Applied",
        ApplicationStatus.Interview => "Interview",
        ApplicationStatus.Offer => "Offer",
        ApplicationStatus.Rejected => "Rejected",
        ApplicationStatus.Withdrawn => "Withdrawn",
        _ => status.ToString()
    };
}
