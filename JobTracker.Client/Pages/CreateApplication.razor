@page "/create-application"
@using FrontendWasm.Models

<h3>Log a New Job Application</h3>

<div style="margin-bottom: 10px;">
    <label>Company Name:</label>
    <input @bind="newApp.CompanyName" />
</div>

<div style="margin-bottom: 10px;">
    <label>Job Title:</label>
    <input @bind="newApp.JobTitle" />
</div>

<button @onclick="SaveApplication">Save Application</button>

@if (isSaved)
{
    <p style="color: green; margin-top: 10px;">Application saved successfully!</p>
}

@code {
    private JobApplication newApp = new JobApplication();   

    private bool isSaved = false;

    private void SaveApplication()
    {
        isSaved = true;
    }
}